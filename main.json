                                      "type": "mrkdwn",
                                      "text": "*Rule*\n@{outputs('Get_Rule_Label')}"
                                    },
                                    {
                                      "type": "mrkdwn",
                                      "text": "*Type*\n`@{outputs('Get_Type_Display')}`"
                                    },
                                    {
                                      "type": "mrkdwn",
                                      "text": "*Item*\n@{outputs('Get_ObjectName')}"
                                    },
