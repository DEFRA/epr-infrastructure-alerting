                      "type": "Compose",
                      "inputs": "@{if(or(equals(outputs('Get_Severity'), 'Sev0'), equals(outputs('Get_Severity'), 'Sev1')), 'danger', if(equals(outputs('Get_Severity'), 'Sev2'), 'warning', 'good'))}",
                      "runAfter": {
