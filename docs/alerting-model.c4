specification {
  element person
  element system
  element container
  element component
}

model {
  platformTeam = person "Platform Team" {
    description "Owns shared alerting pipeline and infrastructure code"
  }

  eprTeams = person "EPR Product Teams" {
    description "Own team alert definitions and notification configuration"
  }

  azureDevOps = system "Azure DevOps" {
    description "Runs validate, what-if, and deploy stages"
  }

  azurePlatform = system "Azure Internal Platform" {
    description "Azure-hosted alert sources and shared alerting resources"

    azureMonitorEvaluation = system "Azure Monitor Evaluation" {
      description "Azure Monitor metric evaluation resources for health alerts"

      azureMonitor = system "Azure Monitor" {
        icon azure:monitor
        description "Fires monitor alerts"
      }

      healthCheckMetricAlert = system "HealthCheck Metric Alert Rule" {
        icon azure:monitor
        technology "Microsoft.Insights/metricAlerts"
        description "Evaluates HealthCheckStatus and fires when below threshold"
      }
    }

    keyVault = system "Azure Key Vault" {
      icon azure:key-vaults
      description "Emits secret near-expiry events"
    }

    functionAppHealth = system "Function App Health Check" {
      icon azure:function-apps
      description "Emits HealthCheckStatus metrics"
    }

    eventGrid = system "Azure Event Grid" {
      icon azure:event-grid-topics
      description "Routes Key Vault events to Azure Monitor"

      keyVaultSystemTopic = container "Key Vault System Topic" {
        icon azure:event-grid-topics
        technology "Microsoft.EventGrid/systemTopics"
        description "System topic bound to Key Vault event source"
      }

      keyVaultExpirySubscription = container "Key Vault Expiry Event Subscription" {
        icon azure:event-grid-subscriptions
        technology "Microsoft.EventGrid/systemTopics/eventSubscriptions"
        description "Filters SecretNearExpiry and forwards to MonitorAlert"
      }
    }

    defenderForCloud = system "Microsoft Defender for Cloud" {
      icon azure:microsoft-defender-for-cloud
      description "Scans ACR images and exports vulnerability findings to Log Analytics"
    }

    logAnalyticsWorkspace = system "Log Analytics Workspace" {
      icon azure:log-analytics-workspaces
      description "Receives Defender for Cloud exports; queried by scheduled alert rules"
    }

    acrVulnerabilityScheduledAlert = system "ACR Vulnerability Scheduled Alert" {
      icon azure:monitor
      technology "Microsoft.Insights/scheduledQueryRules"
      description "Log Alert V2 querying SecurityRecommendation for High/Critical ACR findings"
    }

    containerRegistry = system "Azure Container Registry" {
      icon azure:container-registries
      description "Hosts container images scanned by Defender for Cloud"
    }

    sharedAlerting = system "Shared Alerting Platform" {
      description "Bicep-defined multi-team alert notification facility"

      pipeline = container "Alerting Pipeline" {
        technology "Azure Pipelines"
        description "Validate/What-If/Deploy for shared-infra/alerting"
      }

      alertingConfig = container "Alerting Team Config" {
        technology "Bicep Params"
        description "teams[] and slackWebhookUrls"
      }

      actionGroups = container "Alert Action Groups" {
        icon azure:monitor
        technology "Microsoft.Insights/actionGroups"
        description "One action group per team with multiple receiver types"
      }

      slackLogicApps = container "Slack Logic Apps" {
        icon azure:logic-apps
        technology "Microsoft.Logic/workflows"
        description "Formats and posts alert messages to Slack"
      }

      typeSpecificLogicApps = system "Type-Specific Slack Logic Apps" {
        description "Alert-type-specific Logic Apps; one per type per team"

        healthCheckSlackLogicApp = container "HealthCheck Slack Logic App" {
          icon azure:logic-apps
          technology "Microsoft.Logic/workflows"
          description "Formats health check alerts and posts to team Slack channel"
        }

        acrVulnerabilitySlackLogicApp = container "ACR Vulnerability Slack Logic App" {
          icon azure:logic-apps
          technology "Microsoft.Logic/workflows"
          description "Formats ACR vulnerability alerts and posts to team Slack channel"
        }
      }

      typeSpecificActionGroups = system "Type-Specific Action Groups" {
        description "Alert-type-specific Action Groups; one per type per team"

        healthCheckActionGroup = container "HealthCheck Action Group" {
          icon azure:monitor
          technology "Microsoft.Insights/actionGroups"
          description "Routes health check alerts to HealthCheck Logic App"
        }

        acrVulnerabilityActionGroup = container "ACR Vulnerability Action Group" {
          icon azure:monitor
          technology "Microsoft.Insights/actionGroups"
          description "Routes ACR vulnerability alerts to ACR Vulnerability Logic App"
        }
      }

      emailReceiver = component "Email Receiver" {
        technology "Action Group emailReceivers"
        description "Optional team email notifications"
      }

      webhookReceiver = component "Webhook Receiver" {
        technology "Action Group webhookReceivers"
        description "Optional non-Slack webhook notifications"
      }
    }
  }

  externalAlerting = system "External SaaS Alerting" {
    description "Third-party notification platforms outside Azure"

    slackWorkspace = system "Defra Digital Team Slack Workspace" {
      icon tech:slack
      description "Receives Slack notifications"
    }
  }

  platformTeam -> pipeline "Maintains"
  eprTeams -> alertingConfig "Contributes configuration to"
  pipeline -> alertingConfig "Reads"
  pipeline -> actionGroups "Deploys"
  pipeline -> slackLogicApps "Deploys"

  keyVault -> keyVaultSystemTopic "Publishes SecretNearExpiry events"
  keyVaultSystemTopic -> keyVaultExpirySubscription "Routes matching events"
  keyVaultExpirySubscription -> azureMonitorEvaluation.azureMonitor "Delivers MonitorAlert events"
  azureMonitorEvaluation.azureMonitor -> actionGroups "Triggers via monitor alert"
  functionAppHealth -> azureMonitorEvaluation.healthCheckMetricAlert "Publishes health metrics"
  actionGroups -> slackLogicApps "Invokes Logic App receiver"
  slackLogicApps -> slackWorkspace "Posts message via incoming webhook"

  actionGroups -> emailReceiver "Sends optional email notifications"
  actionGroups -> webhookReceiver "Sends optional webhook notifications"

  containerRegistry -> defenderForCloud "Images scanned by"
  defenderForCloud -> logAnalyticsWorkspace "Exports findings via Continuous Export"
  logAnalyticsWorkspace -> acrVulnerabilityScheduledAlert "Queried by"
  acrVulnerabilityScheduledAlert -> acrVulnerabilityActionGroup "Fires alert to"
  acrVulnerabilityActionGroup -> acrVulnerabilitySlackLogicApp "Invokes"
  acrVulnerabilitySlackLogicApp -> slackWorkspace "Posts ACR vulnerability message"

  azureMonitorEvaluation.healthCheckMetricAlert -> healthCheckActionGroup "Fires alert to"
  healthCheckActionGroup -> healthCheckSlackLogicApp "Invokes"
  healthCheckSlackLogicApp -> slackWorkspace "Posts health check message"
}

views {
  view index {
    title "Alert Runtime Path"
    include azurePlatform
    include externalAlerting
    include keyVault
    include functionAppHealth
    include eventGrid
    include eventGrid.keyVaultSystemTopic
    include eventGrid.keyVaultExpirySubscription
    include azureMonitorEvaluation
    include azureMonitorEvaluation.azureMonitor
    include azureMonitorEvaluation.healthCheckMetricAlert
    include sharedAlerting.actionGroups
    include sharedAlerting.slackLogicApps
    include sharedAlerting.emailReceiver
    include sharedAlerting.webhookReceiver
    include slackWorkspace

    include keyVault -> keyVaultSystemTopic with {
      color green
      line solid
    }

    include keyVaultSystemTopic -> keyVaultExpirySubscription with {
      color green
      line solid
    }

    include keyVaultExpirySubscription -> azureMonitorEvaluation.azureMonitor with {
      color green
      line solid
    }

    include azureMonitorEvaluation.azureMonitor -> actionGroups with {
      color green
      line solid
    }

    include functionAppHealth -> azureMonitorEvaluation.healthCheckMetricAlert with {
      color red
      line solid
    }

    style azurePlatform {
      color indigo
      opacity 12%
      border solid
    }

    style externalAlerting {
      color amber
      opacity 16%
      border solid
    }

    style azureMonitorEvaluation {
      color primary
      opacity 12%
      border solid
    }

    style azureMonitorEvaluation.azureMonitor {
      color primary
    }

    style azureMonitorEvaluation.healthCheckMetricAlert {
      color red
    }

    style keyVault {
      color green
    }

    style functionAppHealth {
      color red
    }

    style eventGrid {
      color secondary
      opacity 12%
      border solid
    }

    style eventGrid.keyVaultSystemTopic {
      color indigo
    }

    style eventGrid.keyVaultExpirySubscription {
      color amber
    }

    style sharedAlerting.actionGroups {
      color secondary
    }

    style sharedAlerting.slackLogicApps {
      color muted
    }

    style sharedAlerting.emailReceiver {
      color gray
    }

    style sharedAlerting.webhookReceiver {
      color gray
    }

    style slackWorkspace {
      color amber
    }
  }

  view v2 {
    title "Alert Runtime Path v2"
    include azurePlatform
    include externalAlerting
    include containerRegistry
    include defenderForCloud
    include logAnalyticsWorkspace
    include acrVulnerabilityScheduledAlert
    include sharedAlerting.typeSpecificActionGroups
    include sharedAlerting.typeSpecificActionGroups.acrVulnerabilityActionGroup
    include sharedAlerting.typeSpecificActionGroups.healthCheckActionGroup
    include sharedAlerting.typeSpecificLogicApps
    include sharedAlerting.typeSpecificLogicApps.acrVulnerabilitySlackLogicApp
    include sharedAlerting.typeSpecificLogicApps.healthCheckSlackLogicApp
    include functionAppHealth
    include azureMonitorEvaluation.healthCheckMetricAlert
    include keyVault
    include eventGrid
    include eventGrid.keyVaultSystemTopic
    include eventGrid.keyVaultExpirySubscription
    include azureMonitorEvaluation.azureMonitor
    include sharedAlerting.actionGroups
    include sharedAlerting.slackLogicApps
    include slackWorkspace

    // ACR vulnerability path
    include containerRegistry -> defenderForCloud with {
      color sky
      line solid
    }
    include defenderForCloud -> logAnalyticsWorkspace with {
      color sky
      line solid
    }
    include logAnalyticsWorkspace -> acrVulnerabilityScheduledAlert with {
      color sky
      line solid
    }
    include acrVulnerabilityScheduledAlert -> sharedAlerting.typeSpecificActionGroups.acrVulnerabilityActionGroup with {
      color sky
      line solid
    }
    include sharedAlerting.typeSpecificActionGroups.acrVulnerabilityActionGroup -> sharedAlerting.typeSpecificLogicApps.acrVulnerabilitySlackLogicApp with {
      color sky
      line solid
    }
    include sharedAlerting.typeSpecificLogicApps.acrVulnerabilitySlackLogicApp -> slackWorkspace with {
      color sky
      line solid
    }

    // Health check path
    include functionAppHealth -> azureMonitorEvaluation.healthCheckMetricAlert with {
      color amber
      line solid
    }
    include azureMonitorEvaluation.healthCheckMetricAlert -> sharedAlerting.typeSpecificActionGroups.healthCheckActionGroup with {
      color amber
      line solid
    }
    include sharedAlerting.typeSpecificActionGroups.healthCheckActionGroup -> sharedAlerting.typeSpecificLogicApps.healthCheckSlackLogicApp with {
      color amber
      line solid
    }
    include sharedAlerting.typeSpecificLogicApps.healthCheckSlackLogicApp -> slackWorkspace with {
      color amber
      line solid
    }

    // Key Vault path (shared generic action group + logic app, not yet type-specific)
    include keyVault -> eventGrid.keyVaultSystemTopic with {
      color green
      line solid
    }
    include eventGrid.keyVaultSystemTopic -> eventGrid.keyVaultExpirySubscription with {
      color green
      line solid
    }
    include eventGrid.keyVaultExpirySubscription -> azureMonitorEvaluation.azureMonitor with {
      color green
      line solid
    }
    include azureMonitorEvaluation.azureMonitor -> sharedAlerting.actionGroups with {
      color green
      line solid
    }
    include sharedAlerting.actionGroups -> sharedAlerting.slackLogicApps with {
      color green
      line solid
    }
    include sharedAlerting.slackLogicApps -> slackWorkspace with {
      color green
      line solid
    }

    style azurePlatform {
      color indigo
      opacity 12%
      border solid
    }
    style externalAlerting {
      color amber
      opacity 16%
      border solid
    }
    style azureMonitorEvaluation {
      color primary
      opacity 12%
      border solid
    }
    style eventGrid {
      color secondary
      opacity 12%
      border solid
    }
    style azureMonitorEvaluation.azureMonitor {
      color green
    }
    style azureMonitorEvaluation.healthCheckMetricAlert {
      color amber
    }
    style containerRegistry {
      color sky
    }
    style defenderForCloud {
      color sky
    }
    style logAnalyticsWorkspace {
      color sky
    }
    style acrVulnerabilityScheduledAlert {
      color sky
    }
    style functionAppHealth {
      color amber
    }
    style keyVault {
      color green
    }
    style eventGrid.keyVaultSystemTopic {
      color green
    }
    style eventGrid.keyVaultExpirySubscription {
      color green
    }
    style sharedAlerting.typeSpecificActionGroups {
      color secondary
      opacity 15%
      border dashed
    }
    style sharedAlerting.typeSpecificLogicApps {
      color muted
      opacity 15%
      border dashed
    }
    style sharedAlerting.typeSpecificActionGroups.acrVulnerabilityActionGroup {
      color sky
    }
    style sharedAlerting.typeSpecificLogicApps.acrVulnerabilitySlackLogicApp {
      color sky
    }
    style sharedAlerting.typeSpecificActionGroups.healthCheckActionGroup {
      color amber
    }
    style sharedAlerting.typeSpecificLogicApps.healthCheckSlackLogicApp {
      color amber
    }
    style sharedAlerting.actionGroups {
      color green
    }
    style sharedAlerting.slackLogicApps {
      color green
    }
    style slackWorkspace {
      color amber
    }
  }
}
